{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auwe",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "preview_urls": false,
  "upload_source_maps": true,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  }
}
